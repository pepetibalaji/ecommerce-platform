# =========================================================
# CART SERVICE API TESTS
# =========================================================
# Service: cart-service
# Base URL: http://localhost:8085
#
# Cart is Redis-backed.
# Redis key pattern:
# cart:{userId}
#
# User identity comes from JWT claim:
# userId
# =========================================================

@cartBaseUrl = http://localhost:8085

# Replace after Auth login with CUSTOMER token
@accessToken = paste_customer_access_token_here

# Use an existing Product Service product ID
@productId = paste_product_id_here

# Replace after adding item if response returns itemId
@itemId = paste_cart_item_id_here

# =========================================================
# CART APIs
# Requires authenticated CUSTOMER or ADMIN token
# =========================================================

### Add item to cart
POST {{cartBaseUrl}}/api/v1/cart
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 2
}

### Get current user's cart
GET {{cartBaseUrl}}/api/v1/cart
Authorization: Bearer {{accessToken}}

### Update cart item quantity
PUT {{cartBaseUrl}}/api/v1/cart/{{itemId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "quantity": 5
}

### Remove item from cart
DELETE {{cartBaseUrl}}/api/v1/cart/{{itemId}}
Authorization: Bearer {{accessToken}}

### Clear cart
DELETE {{cartBaseUrl}}/api/v1/cart
Authorization: Bearer {{accessToken}}

# =========================================================
# SECURITY CHECKS
# =========================================================

### Get cart without token - expected 401
GET {{cartBaseUrl}}/api/v1/cart

### Add item without token - expected 401
POST {{cartBaseUrl}}/api/v1/cart
Content-Type: application/json

{
  "productId": "{{productId}}",
  "quantity": 2
}

# =========================================================
# SWAGGER / ACTUATOR
# =========================================================

### Swagger UI
GET {{cartBaseUrl}}/swagger-ui.html

### OpenAPI JSON
GET {{cartBaseUrl}}/v3/api-docs

### Health
GET {{cartBaseUrl}}/actuator/health

### Prometheus metrics
GET {{cartBaseUrl}}/actuator/prometheus

# =========================================================
# REDIS VERIFICATION
# =========================================================
# After adding items, verify in Redis:
#
# docker exec -it ecommerce-redis redis-cli
#
# KEYS cart:*
#
# Expected:
# cart:<userId>
# =========================================================