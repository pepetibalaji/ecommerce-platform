# The only browser API origin. Never put service URLs or secrets in this file.
VITE_API_BASE_URL=http://localhost:8080
VITE_SESSION_IDLE_TIMEOUT_MS=1800000
VITE_SESSION_WARNING_MS=300000

# `true` is for visual/demo development with `npm run dev` only.
# Builds and production mode reject mock data; stage/prod must use `false`.
VITE_USE_MOCKS=false

VITE_APP_NAME=PepeKart
